---
import type { UiKey } from "../../i18n/ui";
import { getProjectPath } from "../../i18n/utils";
import GithubIcon from "../../icons/GithubIcon.astro";
import type { Locale, Project } from "../../types/portfolio";
import RelatedProjectSites from "./RelatedProjectSites.astro";

interface Props {
	project: Project;
	lang: Locale;
	t: (key: UiKey) => string;
	featured?: boolean;
}

const { project, lang, t, featured = false } = Astro.props;
const preview = featured ? project.caseStudy?.image : undefined;
const relatedSites = project.caseStudy?.relatedSites ?? [];
const catalogCount = relatedSites.length + (project.links?.demo ? 1 : 0);
const accessLabel = t(project.access === "open-source" ? "projects.openSource" : "projects.privateClient");
const Heading = featured ? "h3" : "h4";
---

<article class:list={{ "featured-project": featured, "project-row": !featured }}>
	<div class:list={{ "featured-project__lead": featured, "project-row__content": !featured }}>
		<div class:list={{ "featured-project__copy": featured, "contents": !featured }}>
			<div>
				<p class:list={["font-mono text-xs", featured ? "text-amber" : "text-muted"]}>
					{featured ? t("projects.featured") : accessLabel}
				</p>
				<Heading class:list={[
					"mt-1 font-display font-medium leading-tight tracking-tight text-primary",
					featured ? "text-3xl text-balance sm:text-4xl" : "text-xl",
				]}>
					{project.name}
				</Heading>
			</div>

			<div>
				<p class:list={["leading-relaxed text-secondary", featured ? "text-base" : "text-sm"]}>{project.summary}</p>
				{project.tags.length > 0 && (
					// biome-ignore lint/a11y/noRedundantRoles: Keep list semantics in Safari when markers are hidden.
					<ul class="mt-2.5 flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs text-muted" role="list">
						{project.tags.slice(0, 4).map((tag) => <li>{tag}</li>)}
					</ul>
				)}
			</div>

			<div class="project-actions">
				{project.caseStudy && (
					<a href={getProjectPath(project.id, lang)} class="project-action project-action--case">
						{t("projects.viewCase")}
						<span class="sr-only"> · {project.name}</span>
						<span aria-hidden="true">→</span>
					</a>
				)}
				{project.links?.demo && (
					<a href={project.links.demo} target="_blank" rel="noopener noreferrer" class="project-action">
						{t("projects.demo")}
						<span class="sr-only"> · {project.name}</span>
						<span aria-hidden="true">↗</span>
					</a>
				)}
				{project.links?.repo && (
					<a href={project.links.repo} target="_blank" rel="noopener noreferrer" class="project-action">
						<GithubIcon class="shrink-0" aria-hidden="true" />
						{t("projects.repository")}
						<span class="sr-only"> · {project.name}</span>
					</a>
				)}
			</div>
		</div>

		{preview && (
			<figure class="min-w-0 overflow-hidden rounded-xl border border-border bg-surface-1">
				<figcaption class="flex items-center gap-2 border-b border-border px-3 py-2 font-mono text-xs text-secondary">
					<span aria-hidden="true" class="size-1.5 shrink-0 rounded-full bg-amber"></span>
					{t("projects.catalogPreview")}
				</figcaption>
				<img
					src={preview.src}
					alt={preview.alt}
					width={preview.width}
					height={preview.height}
					loading="lazy"
					decoding="async"
					class="block h-auto w-full"
				/>
			</figure>
		)}
	</div>

	{relatedSites.length > 0 && (
		<div class="featured-project__catalogs">
			<div>
				<h4 class="font-display text-xl font-medium leading-tight text-primary">{t("projects.relatedSites")}</h4>
				<p class="mt-1.5 max-w-54 text-sm leading-snug text-secondary">
					<strong class="font-medium text-amber">{catalogCount}</strong> {t("projects.liveCatalogs")}
				</p>
			</div>
			<RelatedProjectSites sites={relatedSites} />
		</div>
	)}
</article>

<style>
	.featured-project {
		--project-inset: clamp(1rem, 3vw, 1.75rem);
		border: 1px solid var(--token-border);
		border-block-start: 2px solid var(--token-amber);
		border-radius: 1rem;
		background: var(--token-surface);
	}

	.featured-project__lead,
	.featured-project__catalogs {
		display: grid;
		gap: clamp(1.25rem, 3.5vw, 2rem);
		padding: var(--project-inset);
	}

	.featured-project__lead {
		align-items: center;
	}

	.featured-project__copy {
		display: grid;
		gap: 1rem;
	}

	.featured-project__catalogs {
		border-block-start: 1px solid var(--token-border);
	}

	.project-row__content {
		display: grid;
		gap: 0.75rem;
		padding-block: 1.25rem;
	}

	.project-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem 0.5rem;
	}

	.project-action {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		min-height: 2.75rem;
		border: 1px solid var(--token-border);
		border-radius: 0.55rem;
		padding: 0.375rem 0.625rem;
		color: var(--token-text-primary);
		font-size: 0.8125rem;
		font-weight: 500;
		transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
	}

	.project-action--case {
		color: var(--token-amber);
		background: var(--token-amber-bg);
	}

	.project-action:hover {
		border-color: color-mix(in srgb, var(--token-amber) 50%, var(--token-border));
		color: var(--token-amber);
		background: var(--token-surface-hover);
	}

	@media (min-width: 45rem) {
		.featured-project__lead {
			grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.2fr);
		}

		.featured-project__catalogs {
			grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.4fr);
			align-items: start;
		}

		.featured-project__catalogs > div {
			padding-top: 0.625rem;
		}

		.project-row__content {
			grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.7fr);
			gap: 0.5rem 1.25rem;
		}

		.project-row__content .project-actions {
			grid-column: 2;
		}
	}

	@media (min-width: 56rem) {
		.project-row__content {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr) minmax(0, 1.3fr);
			align-items: start;
		}

		.project-row__content .project-actions {
			grid-column: 3;
			justify-content: flex-end;
		}
	}
</style>
