---
import { render } from "astro:content";
import { useTranslations } from "../../i18n/ui";
import { getLocalizedPath } from "../../i18n/utils";
import {
	type BlogPost,
	formatReadingTime,
	getReadingTimeMinutes,
} from "../../lib/blog";
import type { Locale, PortfolioData } from "../../types/portfolio";
import Header from "../Header.astro";
import Footer from "../sections/Footer.astro";
import BlogPostMeta from "./BlogPostMeta.astro";
import BlogPostNav from "./BlogPostNav.astro";

interface Props {
	post: BlogPost;
	lang: Locale;
	portfolio: PortfolioData;
	alternatePath?: string;
}

const { post, lang, portfolio, alternatePath } = Astro.props;
const { authorName } = portfolio;
const { coverImage, coverDetails } = post.data;
const t = useTranslations(lang);
const { Content, headings } = await render(post);
const sections = headings.filter(({ depth }) => depth === 2);
const blogIndexPath = getLocalizedPath("/blog", lang);
const readingTime = formatReadingTime(
	getReadingTimeMinutes(post.body),
	lang,
);
---

<Header lang={lang} showBlog alternatePath={alternatePath} />
<main id="main-content" tabindex="-1" class="px-6 pt-28 pb-16">
	<article class="mx-auto max-w-4xl">
		<a
			href={blogIndexPath}
			class="inline-flex items-center gap-1.5 font-mono text-xs text-muted hover:text-amber transition-colors mb-8"
		>
			<span aria-hidden="true">←</span>
			{t("blog.backToBlog")}
		</a>

		<header class="mb-7 max-w-3xl sm:mb-8">
			<BlogPostMeta
				changeType={post.data.changeType}
				version={post.data.version}
				publishedAt={post.data.publishedAt}
				updatedAt={post.data.updatedAt}
				lang={lang}
				publishedLabel={t("blog.publishedOn")}
				updatedLabel={t("blog.updatedOn")}
				readingTime={readingTime}
			/>
			<h1 class="mt-4 max-w-3xl font-display text-4xl leading-[1.05] font-medium tracking-tight text-balance text-primary sm:text-5xl md:text-6xl">
				{post.data.title}
			</h1>
			<p class="mt-4 max-w-xl text-base leading-relaxed text-secondary sm:text-lg">
				{post.data.description}
			</p>
			<div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2">
				<p class="text-sm font-medium text-primary">
					<span class="sr-only">{t("blog.authorLabel")}: </span>
					{authorName}
				</p>
				{
					post.data.assistedByAi && (
						<p class="rounded-md border border-border px-2 py-0.5 font-mono text-[11px] text-secondary">{t("blog.assistedByAi")}</p>
					)
				}
			</div>
			{
				post.data.tags.length > 0 && (
					<div class="flex flex-wrap gap-2 mt-4">
						{post.data.tags.map((tag) => (
							<span class="font-mono text-[11px] text-muted bg-surface-1 px-2 py-0.5 rounded-md">
								{tag}
							</span>
						))}
					</div>
				)
			}
		</header>

		{coverImage && coverDetails && (
			<figure class="mb-8 sm:mb-10">
				<img
					src={coverImage}
					alt={coverDetails.alt}
					width={coverDetails.width}
					height={coverDetails.height}
					fetchpriority="high"
					class="block h-auto w-full rounded-2xl border border-border bg-surface-1"
				/>
				{coverDetails.caption && (
					<figcaption class="mt-3 font-mono text-xs leading-relaxed text-muted">{coverDetails.caption}</figcaption>
				)}
			</figure>
		)}

		{sections.length > 1 && (
			<nav aria-label={t("blog.onThisPage")} class="mx-auto mb-8 max-w-2xl rounded-xl border border-border bg-surface p-4 sm:p-5">
				<p class="mb-2 font-mono text-xs text-amber">{t("blog.onThisPage")}</p>
				<ul class="grid gap-x-4 sm:grid-cols-2">
					{sections.map(({ slug, text }) => (
						<li>
							<a href={`#${slug}`} class="flex min-h-9 items-center gap-2 rounded-md text-sm text-secondary transition-colors hover:text-primary">
								<span aria-hidden="true" class="font-mono text-xs text-amber">#</span>
								{text}
							</a>
						</li>
					))}
				</ul>
			</nav>
		)}

		<div class="prose-blog mx-auto max-w-2xl">
			<Content />
		</div>

		<BlogPostNav currentPost={post} lang={lang} t={t} />
	</article>
</main>
<Footer data={portfolio} lang={lang} t={t} />
