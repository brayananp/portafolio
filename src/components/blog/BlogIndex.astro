---
import { useTranslations } from "../../i18n/ui";
import { getAlternateLang, getLocalizedPath } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import { getPublishedBlogPosts } from "../../lib/blog";
import { absoluteUrl, buildBreadcrumbJsonLd, getSiteUrl } from "../../lib/seo";
import type { Locale, PortfolioData } from "../../types/portfolio";
import Header from "../Header.astro";
import Footer from "../sections/Footer.astro";
import BlogPostCard from "./BlogPostCard.astro";

interface Props {
	lang: Locale;
	title: string;
	description: string;
	portfolio: PortfolioData;
}

const { lang, title, description, portfolio } = Astro.props;
const { authorName } = portfolio;
const t = useTranslations(lang);
const alternateLang = getAlternateLang(lang);
const [posts, alternatePosts] = await Promise.all([
	getPublishedBlogPosts(lang),
	getPublishedBlogPosts(alternateLang),
]);
const [featuredPost, ...otherPosts] = posts;
const hasPosts = Boolean(featuredPost);
const alternatePath = alternatePosts.length > 0
	? getLocalizedPath("/blog", alternateLang)
	: undefined;
const homePath = getLocalizedPath("/", lang);
const path = getLocalizedPath("/blog", lang);
const siteUrl = getSiteUrl(Astro.site);
---

<Layout
	title={title}
	description={description}
	lang={lang}
	path={path}
	authorName={authorName}
	noindex={!hasPosts}
	alternatePath={hasPosts ? alternatePath : undefined}
	jsonLd={[
		buildBreadcrumbJsonLd([
			{ name: t("nav.home"), url: absoluteUrl(siteUrl, homePath) },
			{ name: t("blog.title"), url: absoluteUrl(siteUrl, path) },
		]),
	]}
>
	<Header lang={lang} showBlog={hasPosts} alternatePath={alternatePath} />
	<main id="main-content" tabindex="-1" class="px-6 pt-28 pb-16">
		<div class="mx-auto max-w-4xl">
			<header class="mb-8 sm:mb-10">
				<div class="mb-6">
					<a href={homePath} class="inline-flex items-center gap-1.5 font-mono text-xs text-muted transition-colors hover:text-amber">
						<span aria-hidden="true">←</span>
						{t("blog.backToHome")}
					</a>
				</div>
				<span class="inline-block rounded-md bg-amber-bg px-2.5 py-0.5 font-mono text-xs text-amber">
					{t("blog.badge")}
				</span>
				<h1 class="mt-3 font-display text-4xl font-medium tracking-tight text-primary sm:text-5xl">
					{t("blog.title")}
				</h1>
				<p class="mt-3 max-w-xl text-base leading-relaxed text-secondary">
					{t("blog.subtitle")}
				</p>
			</header>

			{
				featuredPost ? (
					<div class="space-y-4">
						<BlogPostCard post={featuredPost} lang={lang} featured titleTag="h2" />
						{otherPosts.map((post) => (
							<BlogPostCard post={post} lang={lang} titleTag="h2" />
						))}
					</div>
				) : (
					<p class="text-secondary text-sm">{t("blog.noPosts")}</p>
				)
			}
		</div>
	</main>
	<Footer data={portfolio} lang={lang} t={t} />
</Layout>
