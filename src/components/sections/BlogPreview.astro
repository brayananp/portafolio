---
import type { UiKey } from "../../i18n/ui";
import { getLocalizedPath } from "../../i18n/utils";
import type { BlogPost } from "../../lib/blog";
import type { Locale } from "../../types/portfolio";
import BlogPostCard from "../blog/BlogPostCard.astro";

interface Props {
	lang: Locale;
	t: (key: UiKey) => string;
	posts: BlogPost[];
}

const { lang, t, posts } = Astro.props;
const [featuredPost, ...otherPosts] = posts;
const blogIndexPath = getLocalizedPath("/blog", lang);
---

<section id="blog" class="scroll-mt-28 px-6">
	<div class="mx-auto max-w-4xl">
		<span class="inline-block rounded-md bg-amber-bg px-2.5 py-0.5 font-mono text-xs text-amber">
			{t("blog.badge")}
		</span>
		<h2 class="mt-3 mb-5 font-display text-2xl font-medium text-primary">
			{t("blog.title")}
		</h2>

		<div class="space-y-3">
			{featuredPost && <BlogPostCard post={featuredPost} lang={lang} featured />}
			{otherPosts.map((post) => <BlogPostCard post={post} lang={lang} />)}
		</div>

		<a
			href={blogIndexPath}
			class="mt-4 inline-flex min-h-10 items-center gap-2 rounded-md font-mono text-xs text-amber hover:underline"
		>
			{t("blog.viewAll")}
			<span aria-hidden="true">→</span>
		</a>
	</div>
</section>
