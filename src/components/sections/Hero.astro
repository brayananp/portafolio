---
import { Image } from "astro:assets";
import avatarSrc from "../../assets/images/avatar.webp";
import type { UiKey } from "../../i18n/ui";
import type { Locale, PortfolioData } from "../../types/portfolio";
import ExportCvButton from "../ExportCvButton.astro";

interface Props {
	portfolio: PortfolioData;
	lang: Locale;
	t: (key: UiKey) => string;
}

const { portfolio, lang, t } = Astro.props;
const { hero, displayName } = portfolio;
const formattedDate = new Intl.DateTimeFormat(lang === "es" ? "es-PE" : "en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "UTC",
}).format(new Date(hero.releaseDate));
---

<section id="hero" class="px-6 pt-24 sm:pt-28">
	<div class="mx-auto grid max-w-4xl grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-5 sm:items-start sm:gap-x-10">
		<header class="min-w-0">
			<div class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs">
				<span class="rounded-md bg-amber-bg px-2.5 py-0.5 text-amber">{t("hero.badge")}</span>
				<span class="text-amber">{hero.version}</span>
			</div>
			<h1 class="mt-3 font-display text-3xl leading-tight font-medium tracking-tight text-primary min-[440px]:text-4xl sm:text-6xl">
				{displayName}
			</h1>
			<p class="mt-2 font-mono text-xs text-secondary sm:text-sm">{hero.role}</p>
		</header>

		<Image
			src={avatarSrc}
			alt={hero.avatar.alt}
			width={176}
			height={176}
			widths={[80, 96, 160, 176, 192, 288, 352]}
			sizes="(min-width: 640px) 176px, (min-width: 440px) 96px, 80px"
			quality={80}
			format="webp"
			class="size-20 rounded-xl border border-border bg-surface-1 object-cover object-top ring-2 ring-amber/15 min-[440px]:size-24 sm:col-start-2 sm:row-span-2 sm:row-start-1 sm:size-44 sm:rounded-2xl"
			loading="eager"
			fetchpriority="high"
			decoding="async"
		/>

		<div class="col-span-2 min-w-0 sm:col-span-1">
			<p class="max-w-xl text-base leading-relaxed text-secondary sm:text-lg">{hero.tagline}</p>

			<div class="mt-5 flex flex-wrap items-center gap-2">
				<a href="#projects" class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-amber-bg px-4 py-2 font-mono text-xs text-amber transition-colors hover:bg-surface-hover">
					{t("hero.viewProjects")}
					<span aria-hidden="true">↓</span>
				</a>
				<a href="#contact" class="inline-flex min-h-11 items-center rounded-lg border border-border px-4 py-2 font-mono text-xs text-primary transition-colors hover:border-amber/50 hover:bg-surface-hover">
					{t("hero.contact")}
				</a>
				<ExportCvButton portfolio={portfolio} lang={lang} t={t} />
			</div>

			<p class="mt-5 font-mono text-xs leading-relaxed text-secondary">{t("hero.proof")}</p>
			<p class="mt-2 font-mono text-[11px] text-muted">
				{t("hero.releaseDate")} · <time datetime={hero.releaseDate}>{formattedDate}</time>
			</p>
		</div>
	</div>
</section>
