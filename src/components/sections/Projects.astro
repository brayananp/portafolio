---
import type { UiKey } from "../../i18n/ui";
import type { Locale, PortfolioData } from "../../types/portfolio";
import ProjectCard from "../projects/ProjectCard.astro";

interface Props {
	data: PortfolioData["projects"];
	lang: Locale;
	t: (key: UiKey) => string;
}

const { data, lang, t } = Astro.props;
const featuredProject = data.find((project) => project.caseStudy?.image);
const otherProjects = data.filter((project) => project !== featuredProject);
---

<section id="projects" tabindex="-1" aria-labelledby="projects-heading" class="scroll-mt-28 px-6">
	<div class="mx-auto max-w-4xl">
		<header class="mb-7 sm:mb-9">
			<p class="flex items-center gap-2 font-mono text-xs text-amber">
				<span aria-hidden="true">//</span> {t("projects.badge")}
			</p>
			<h2 id="projects-heading" class="mt-2 font-display text-4xl font-medium leading-tight tracking-tight text-primary sm:text-5xl">
				{t("projects.title")}
			</h2>
			<p class="mt-2 max-w-lg text-sm leading-relaxed text-secondary sm:text-base">
				{t("projects.subtitle")}
			</p>
		</header>

		{featuredProject && <ProjectCard project={featuredProject} lang={lang} t={t} featured />}
		{otherProjects.length > 0 && (
			<div class="mt-10 sm:mt-12">
				<h3 class="mb-4 font-display text-2xl font-medium tracking-tight text-primary">{t("projects.other")}</h3>
				{/* biome-ignore lint/a11y/noRedundantRoles: Keep list semantics in Safari when markers are hidden. */}
				<ul class="divide-y divide-border border-y border-border" role="list">
					{otherProjects.map((project) => (
						<li><ProjectCard project={project} lang={lang} t={t} /></li>
					))}
				</ul>
			</div>
		)}
	</div>
</section>
