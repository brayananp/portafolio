---
import type { UiKey } from "../../i18n/ui";
import EmailIcon from "../../icons/EmailIcon.astro";
import GithubIcon from "../../icons/GithubIcon.astro";
import LinkedinIcon from "../../icons/LinkedinIcon.astro";
import WhatsappIcon from "../../icons/WhatsappIcon.astro";
import type { PortfolioData } from "../../types/portfolio";

interface Props {
	data: PortfolioData["contact"];
	t: (key: UiKey) => string;
}

const { data, t } = Astro.props;
const emailAddress = data.email.replace(/^mailto:/, "").split("?")[0];

type ContactIconKey = "email" | "whatsapp" | "linkedin" | "github";

const iconMap = {
	email: EmailIcon,
	whatsapp: WhatsappIcon,
	linkedin: LinkedinIcon,
	github: GithubIcon,
} as const;

const links: { href: string; label: string; icon: ContactIconKey }[] = [
	{ href: data.email, label: t("contact.email"), icon: "email" },
	{ href: data.whatsapp, label: t("contact.whatsapp"), icon: "whatsapp" },
	{ href: data.linkedin, label: t("contact.linkedin"), icon: "linkedin" },
	{ href: data.github, label: t("contact.github"), icon: "github" },
];
---

<section id="contact" tabindex="-1" class="px-6 scroll-mt-28">
	<div class="max-w-4xl mx-auto">
		<span
			class="inline-block font-mono text-xs text-amber bg-amber-bg px-2.5 py-0.5 rounded-md"
		>
			{t("contact.badge")}
		</span>
		<h2 class="font-display font-medium text-2xl mt-3 mb-2 text-primary">
			{t("contact.title")}
		</h2>
		<p class="text-secondary text-sm mb-5 max-w-2xl">{t("contact.subtitle")}</p>

		<ul class="flex flex-wrap gap-2 font-mono text-xs">
			{
				links.map((link) => {
					const Icon = iconMap[link.icon];

					return (
						<li>
							<a
								href={link.href}
								target={link.icon === "email" ? undefined : "_blank"}
								rel={link.icon === "email" ? undefined : "noopener noreferrer"}
								class="inline-flex min-h-11 max-w-full items-center gap-2 rounded-lg border border-border bg-surface px-3 py-2 text-secondary transition-colors hover:border-amber/50 hover:text-amber"
							>
								<Icon class="shrink-0" aria-hidden="true" />
								{link.icon === "email" ? (
									<span class="min-w-0 break-all">
										<span class="sr-only">{link.label} · </span>{emailAddress}
									</span>
								) : link.label}
							</a>
						</li>
					);
				})
			}
		</ul>
	</div>
</section>
