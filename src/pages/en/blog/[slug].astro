---
import BlogArticle from "../../../components/blog/BlogArticle.astro";
import { portfolio } from "../../../data/portfolio.en";
import { getLocalizedPath } from "../../../i18n/utils";
import Layout from "../../../layouts/Layout.astro";
import {
	getAlternateBlogPostPath,
	getBlogPostPath,
	getPublishedBlogPosts,
	getReadingTimeMinutes,
	getSlugFromPostId,
} from "../../../lib/blog";
import {
absoluteUrl,
buildArticleJsonLd,
buildBreadcrumbJsonLd,
DEFAULT_OG_IMAGE,
getSiteUrl,
} from "../../../lib/seo";

export async function getStaticPaths() {
	const posts = await getPublishedBlogPosts("en");

	return posts.map((post) => ({
		params: { slug: getSlugFromPostId(post.id) },
		props: { post },
	}));
}

const { post } = Astro.props;
const slug = getSlugFromPostId(post.id);
const path = getBlogPostPath("en", slug);
const siteUrl = getSiteUrl(Astro.site);
const pageUrl = absoluteUrl(siteUrl, path);
const alternatePath = await getAlternateBlogPostPath(post, "en");
const coverImage = post.data.coverImage ?? DEFAULT_OG_IMAGE;
const readingTimeMinutes = getReadingTimeMinutes(post.body);
const jsonLd = [
	buildArticleJsonLd({
		siteUrl,
		title: post.data.title,
		description: post.data.description,
		url: pageUrl,
		image: absoluteUrl(siteUrl, coverImage),
		authorName: portfolio.authorName,
		publishedAt: post.data.publishedAt,
		updatedAt: post.data.updatedAt,
		locale: "en",
		readingTimeMinutes,
	}),
	buildBreadcrumbJsonLd([
		{ name: "Home", url: absoluteUrl(siteUrl, getLocalizedPath("/", "en")) },
		{ name: "Blog", url: absoluteUrl(siteUrl, getLocalizedPath("/blog", "en")) },
		{ name: post.data.title, url: pageUrl },
	]),
];
---

<Layout
	title={`${post.data.title} — Blog`}
	description={post.data.description}
	lang="en"
	path={path}
	image={coverImage}
	imageAlt={post.data.coverImage ? post.data.coverDetails?.alt ?? post.data.title : undefined}
	imageDimensions={post.data.coverImage ? post.data.coverDetails : undefined}
	ogType="article"
	publishedAt={post.data.publishedAt}
	modifiedAt={post.data.updatedAt}
	authorName={portfolio.authorName}
	alternatePath={alternatePath}
	jsonLd={jsonLd}
>
	<BlogArticle
		post={post}
		lang="en"
	portfolio={portfolio}
		alternatePath={alternatePath}
	/>
</Layout>
